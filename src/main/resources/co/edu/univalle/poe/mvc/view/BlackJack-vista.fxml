<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.layout.StackPane?>
<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="768.0" prefWidth="1024.0" xmlns="http://javafx.com/javafx/21.0.6"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.univalle.poe.mvc.controller.BlackJackController">
   <children>
      <VBox prefHeight="768.0" prefWidth="1024.0">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="150.0" prefWidth="1024.0" spacing="15.0" style="-fx-background-color: #1D2C27; -fx-border-color: transparent transparent #E0BB62 transparent; -fx-border-width: 0 0 2px 0;">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <VBox alignment="CENTER_LEFT" prefHeight="79.0" prefWidth="120.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label prefHeight="58.0" prefWidth="375.0" style="-fx-text-fill:#E0BB62; -fx-font-family: Georgia; -fx-font-weight: bold;" text=" BlackJack" VBox.vgrow="ALWAYS">
                           <font>
                              <Font name="System Bold" size="48.0" />
                           </font>
                        </Label>
                        <Label alignment="CENTER" prefHeight="30.0" prefWidth="143.0" style="-fx-text-fill:white" text="El clásico juego del 21" textAlignment="CENTER" />
                     </children>
                  </VBox>
                  <VBox style="-fx-background-color: #121B18; -fx-background-radius: 8px;" alignment="CENTER" maxHeight="65.0" maxWidth="260.0" prefHeight="65.0" prefWidth="260.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-text-fill:white;-fx-font-family: Segoe UI; -fx-font-weight: bold;" text="FICHAS DISPONIBLES:">
                           <font>
                              <Font name="System Bold" size="16.0" />
                           </font>
                        </Label>
                        <Label fx:id="lblFichas" style="-fx-text-fill:#CAAF6C" text="1000">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  <HBox  alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
                     <children>
                        <Button mnemonicParsing="false" style="-fx-background-color: linear-gradient(to bottom, #27965B, #1D7044); -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-size: 15px; -fx-font-weight: bold; -fx-border-color: #d4af37; -fx-border-width: 2px; -fx-background-radius: 25px; -fx-border-radius: 25px; -fx-cursor: hand;" text="AYUDA">>
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Button>
                        <Button fx:id="btnCerrar" mnemonicParsing="false" style="-fx-background-color: linear-gradient(to bottom, #9C0000, #6D0000); -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-size: 15px; -fx-font-weight: bold; -fx-border-color: #d4af37; -fx-border-width: 2px; -fx-background-radius: 25px; -fx-border-radius: 25px; -fx-cursor: hand;"  text="CERRAR" onAction="#onCerrarJuego">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </HBox>
            <VBox style="-fx-background-color:radial-gradient( center 50% 50%, radius 80%, #2e8b50, #0d4822); " prefHeight="469.0" prefWidth="1024.0" spacing="12.0">
               <padding>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </padding>
               <children>

                  <!-- desde aca es CPU !-->
                  <HBox alignment="CENTER_LEFT" maxWidth="380.0" prefHeight="130.0" prefWidth="380.0" spacing="12.0" style="-fx-background-color: #143520; -fx-background-radius: 12px; -fx-border-color: #D7B868; -fx-border-width: 2px;">
                     <padding>
                        <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
                     </padding>
                     <children>
                        <!-- Texto alineado a la izquierda igual que el del jugador -->
                        <VBox alignment="CENTER_LEFT" spacing="5.0">
                           <children>
                              <Label style="-fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 16px;" text="CARTAS DE LA CPU" />
                              <Label style="-fx-text-fill: #D7B868; -fx-font-size: 14px;" text="Puntaje CPU: 0" />
                           </children>
                        </VBox>
                        <HBox fx:id="contenedorCPU" alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <StackPane prefHeight="95.0" prefWidth="65.0" style="-fx-background-color: #0A1E13; -fx-background-radius: 6px; -fx-border-color: #1A472A; -fx-border-radius: 6px;" />
                              <StackPane prefHeight="95.0" prefWidth="65.0" style="-fx-background-color: #0A1E13; -fx-background-radius: 6px; -fx-border-color: #1A472A; -fx-border-radius: 6px;" />
                           </children>
                        </HBox>
                     </children>
                  </HBox>
                  <!-- hasta aca es CPU !-->

                  <!-- desde aca es Bienvenido.. !-->
                  <HBox alignment="CENTER_LEFT" prefHeight="150.0" prefWidth="994.0" spacing="15.0">
                     <children>
                        <!-- 1. Contenedor del Mazo (fijado a 380px para alinearse con la CPU de arriba) -->
                        <VBox alignment="CENTER" maxWidth="380.0" prefWidth="380.0">
                           <children>
                              <ImageView fitHeight="120.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../images/cards/Cards.png" />
                                 </image>
                              </ImageView>
                              <Label style="-fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold;" text="Mazo: 52/52 cartas" />
                           </children>
                        </VBox>

                        <!-- 2. Cuadro BIENVENIDO (arranca justo en la zona roja y se estira a la derecha) -->
                        <VBox alignment="CENTER" maxWidth="550.0" prefHeight="120.0" prefWidth="500.0" style="-fx-background-color:#1F2B27; -fx-background-radius: 8px; -fx-border-width:3px; -fx-border-color:#D7B868;" HBox.hgrow="ALWAYS">
                           <padding>
                              <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
                           </padding>
                           <children>
                              <Label fx:id="lblmsgUsuario1" style="-fx-text-fill: #D7B868; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold;" text="BIENVENIDO A 21 BLACKJACK" />
                              <Label fx:id="lblmsgUsuario2" style="-fx-text-fill: white;" text="Ingresa una apuesta válida (múltiplo de 10, mínimo 10 fichas) y presiona «Iniciar ronda»." textAlignment="CENTER" wrapText="true" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <!-- hasta aca es bienvenido.. !-->

                  <HBox prefHeight="130.0" prefWidth="994.0" spacing="15.0">
                     <children>

                        <!-- desde aca es TUS CARTAS !-->
                        <HBox alignment="CENTER_LEFT" prefHeight="130.0" prefWidth="380.0" spacing="12.0" style="-fx-background-color: #143520; -fx-background-radius: 12px; -fx-border-color: #D7B868; -fx-border-width: 2px;">
                           <padding>
                              <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
                           </padding>
                           <children>
                              <!-- Información del jugador ajustada automáticamente al texto -->
                              <VBox alignment="CENTER_LEFT" spacing="5.0">
                                 <children>
                                    <Label style="-fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 16px;" text="TUS CARTAS" />
                                    <Label fx:id="lblPuntajeUsuario" style="-fx-text-fill: #D7B868; -fx-font-size: 14px;" text="Tu Puntaje: 0" />
                                 </children>
                              </VBox>

                              <!-- Contenedor de cartas pegado inmediatamente a la izquierda -->
                              <HBox fx:id="contenedorCartasJugador" alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <StackPane prefHeight="95.0" prefWidth="65.0" style="-fx-background-color: #0A1E13; -fx-background-radius: 6px; -fx-border-color: #1A472A; -fx-border-radius: 6px;" />
                                    <StackPane prefHeight="95.0" prefWidth="65.0" style="-fx-background-color: #0A1E13; -fx-background-radius: 6px; -fx-border-color: #1A472A; -fx-border-radius: 6px;" />
                                    <StackPane prefHeight="95.0" prefWidth="65.0" style="-fx-background-color: #0A1E13; -fx-background-radius: 6px; -fx-border-color: #1A472A; -fx-border-radius: 6px;" />
                                 </children>
                              </HBox>
                           </children>
                        </HBox>
                        <!-- hasta aca es TUS CARTAS !-->

                        <HBox fx:id="hboxCartasJugador" alignment="CENTER" prefHeight="100.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label style="-fx-text-fill: white; -fx-font-family: Segoe UI; -fx-font-weight: bold;" text="Esperando Inicio de ronda (sin cartas)" />
                           </children>
                        </HBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
            <HBox style="-fx-background-color:#1C2B26" alignment="CENTER_LEFT" prefHeight="80.0" prefWidth="1024.0" spacing="15.0">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <VBox alignment="CENTER" prefHeight="130.0" prefWidth="0.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label prefHeight="58.0" prefWidth="375.0" style="-fx-text-fill:#E0BB62; -fx-font-family: Georgia; -fx-font-weight: bold;" text="APUESTA ACTUAL: 0" VBox.vgrow="ALWAYS">
                           <font>
                              <Font name="System Bold" size="30.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  <TextField fx:id="txtFieldApuesta" prefWidth="100.0" promptText="EJ: 100" />
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="15.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Button style="-fx-background-color: linear-gradient(to bottom, #2e8b50, #0d4822); -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-size: 15px; -fx-font-weight: bold; -fx-border-color: #d4af37; -fx-border-width: 2px; -fx-background-radius: 25px; -fx-border-radius: 25px; -fx-cursor: hand;" mnemonicParsing="false" prefHeight="35.0" prefWidth="130.0" text="Plantarse">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Button>
                        <Button style="-fx-background-color: linear-gradient(to bottom, #346C9F, #2D547F); -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-size: 15px; -fx-font-weight: bold; -fx-border-color: #d4af37; -fx-border-width: 2px; -fx-background-radius: 25px; -fx-border-radius: 25px; -fx-cursor: hand;" mnemonicParsing="false" prefHeight="35.0" prefWidth="130.0" text="Pedir carta">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Button>
                        <Button fx:id="btnIniciarRonda" style="-fx-background-color: linear-gradient(to bottom, #2B6557, #2B6557); -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-size: 15px; -fx-font-weight: bold; -fx-border-color: #d4af37; -fx-border-width: 2px; -fx-background-radius: 25px; -fx-border-radius: 25px; -fx-cursor: hand;" mnemonicParsing="false" prefHeight="35.0" prefWidth="130.0" text="Iniciar ronda" onAction="#onIniciarRonda">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Button>
                     </children>
                     <padding>
                        <Insets top="10.0" />
                     </padding>
                  </HBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>